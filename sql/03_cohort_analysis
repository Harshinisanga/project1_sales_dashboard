-- ─────────────────────────────────────────────
-- 1. ACQUISITION COHORT TABLE
-- Returns: % of original cohort still purchasing N months later
-- ─────────────────────────────────────────────

WITH cohort_base AS (
    -- Find each customer's first purchase month (cohort assignment)
    SELECT
        customer_id,
        DATE_TRUNC('month', MIN(transaction_date)) AS cohort_month
    FROM transactions
    GROUP BY customer_id
),
customer_activity AS (
    -- All months each customer was active
    SELECT DISTINCT
        t.customer_id,
        DATE_TRUNC('month', t.transaction_date) AS activity_month
    FROM transactions t
),
cohort_activity AS (
    SELECT
        cb.cohort_month,
        ca.activity_month,
        -- Months since cohort acquisition (0 = acquisition month)
        EXTRACT(YEAR  FROM AGE(ca.activity_month, cb.cohort_month)) * 12
        + EXTRACT(MONTH FROM AGE(ca.activity_month, cb.cohort_month)) AS months_since_acquisition,
        COUNT(DISTINCT ca.customer_id) AS active_customers
    FROM cohort_base cb
    JOIN customer_activity ca ON cb.customer_id = ca.customer_id
    GROUP BY 1, 2, 3
),
cohort_sizes AS (
    SELECT cohort_month, COUNT(*) AS cohort_size
    FROM cohort_base
    GROUP BY cohort_month
)
SELECT
    ca.cohort_month,
    cs.cohort_size,
    ca.months_since_acquisition AS period,
    ca.active_customers,
    ROUND(ca.active_customers::NUMERIC / cs.cohort_size * 100, 1) AS retention_rate_pct
FROM cohort_activity ca
JOIN cohort_sizes cs ON ca.cohort_month = cs.cohort_month
WHERE ca.months_since_acquisition BETWEEN 0 AND 11   -- first 12 months
ORDER BY ca.cohort_month, ca.months_since_acquisition;


-- ─────────────────────────────────────────────
-- 2. AVERAGE ORDER FREQUENCY BY COHORT
-- ─────────────────────────────────────────────

WITH cohort_base AS (
    SELECT
        customer_id,
        DATE_TRUNC('month', MIN(transaction_date)) AS cohort_month
    FROM transactions
    GROUP BY customer_id
),
customer_orders AS (
    SELECT
        t.customer_id,
        cb.cohort_month,
        COUNT(*) AS total_orders,
        SUM(t.quantity * t.unit_price) AS total_revenue,
        MAX(t.transaction_date) - MIN(t.transaction_date) AS active_days
    FROM transactions t
    JOIN cohort_base cb ON t.customer_id = cb.customer_id
    GROUP BY 1, 2
)
SELECT
    cohort_month,
    COUNT(*)                                              AS cohort_size,
    ROUND(AVG(total_orders), 1)                           AS avg_orders_per_customer,
    ROUND(AVG(total_revenue), 2)                          AS avg_ltv,
    ROUND(AVG(active_days), 0)                            AS avg_active_days,
    ROUND(AVG(total_revenue) / NULLIF(AVG(total_orders), 0), 2) AS avg_order_value
FROM customer_orders
GROUP BY cohort_month
ORDER BY cohort_month;


-- ─────────────────────────────────────────────
-- 3. RFM SEGMENTATION (Recency, Frequency, Monetary)
-- ─────────────────────────────────────────────

WITH rfm_raw AS (
    SELECT
        customer_id,
        -- Recency: days since last purchase (relative to max date in dataset)
        (SELECT MAX(transaction_date) FROM transactions) - MAX(transaction_date) AS recency_days,
        -- Frequency: number of distinct purchase months
        COUNT(DISTINCT DATE_TRUNC('month', transaction_date)) AS frequency,
        -- Monetary: total revenue
        SUM(quantity * unit_price) AS monetary
    FROM transactions
    GROUP BY customer_id
),
rfm_scored AS (
    SELECT
        customer_id,
        recency_days,
        frequency,
        ROUND(monetary, 2) AS monetary,
        -- Score 1-5 (5 = best) using NTILE
        NTILE(5) OVER (ORDER BY recency_days ASC)  AS r_score,  -- lower recency = better
        NTILE(5) OVER (ORDER BY frequency ASC)      AS f_score,
        NTILE(5) OVER (ORDER BY monetary ASC)       AS m_score
    FROM rfm_raw
),
rfm_segments AS (
    SELECT
        *,
        CASE
            WHEN r_score >= 4 AND f_score >= 4 AND m_score >= 4 THEN 'Champions'
            WHEN r_score >= 4 AND f_score >= 3                   THEN 'Loyal Customers'
            WHEN r_score >= 3 AND f_score = 1                    THEN 'Recent Customers'
            WHEN r_score >= 2 AND f_score >= 2 AND m_score >= 2  THEN 'At Risk'
            WHEN r_score = 1 AND f_score >= 4                    THEN 'Can\'t Lose Them'
            WHEN r_score = 1 AND f_score = 1                     THEN 'Lost'
            ELSE 'Potential Loyalists'
        END AS segment
    FROM rfm_scored
)
SELECT
    segment,
    COUNT(*)                                         AS customer_count,
    ROUND(AVG(recency_days), 0)                      AS avg_recency_days,
    ROUND(AVG(frequency), 1)                         AS avg_frequency,
    ROUND(AVG(monetary), 2)                          AS avg_monetary,
    ROUND(SUM(monetary), 0)                          AS segment_total_revenue,
    ROUND(
        SUM(monetary) / SUM(SUM(monetary)) OVER () * 100, 1
    )                                                AS pct_of_total_revenue
FROM rfm_segments
GROUP BY segment
ORDER BY avg_monetary DESC;
